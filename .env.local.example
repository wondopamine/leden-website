# Supabase application runtime.
# For local lifecycle work, copy the keys printed by `npx supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Order-lifecycle mutation safety.
# Local accepts only the committed 127.0.0.1:54321 stack plus its DB sentinel.
PLAYWRIGHT_NON_PRODUCTION_SUPABASE_URL=http://127.0.0.1:54321
LIFECYCLE_MUTATION_TARGET=local

# Hosted staging remains disabled until U7. When explicitly authorized, all
# three values are mandatory and the exact refs must differ. Refs are not keys.
EXPECTED_STAGING_PROJECT_REF=
PRODUCTION_PROJECT_REF=

# Never put a database password/URL, hosted service key, test bearer secret,
# real customer PII, or production project linkage in a committed env file.

# Resend (legacy optional notification; never an order correctness dependency)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev
CAFE_EMAIL=your-cafe-email@gmail.com

# Google Places API (optional — for live Google Maps rating & reviews)
# Get a key: https://console.cloud.google.com/apis/credentials
# Enable "Places API" in your Google Cloud project
# Without this key, the site shows real reviews collected from Google (Dec 2025).
# With this key, rating/reviews update automatically every 24 hours.
GOOGLE_PLACES_API_KEY=
